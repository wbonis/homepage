# Cache headers for files Apache/nginx serve from client/ (copied to client/.htaccess by
# release.sh). Existing files never reach Node, so its own headers only cover what it answers.
# Security headers come from the Plesk plan (deploy/nginx-directives.conf), not from here.
<IfModule mod_headers.c>
  # Vite writes content-hashed names into /assets/
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Unhashed entry points: revalidate, so a deploy (and the PWA update) is seen at once
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest|version\.txt|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
