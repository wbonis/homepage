# Local .env for release.sh only (gitignored). Names only here: this repo is public.
# Plesk Git webhook URLs (the uuid is a secret; reachable only from the admin network/VPN).
PLESK_WEBHOOK_STAGING=
PLESK_WEBHOOK_LIVE=

# Runtime variables of the contact server live ONLY in Plesk (per domain), never in a local
# .env: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_TLS_SERVERNAME, MAIL_FROM_NAME,
# MAIL_FROM_ADDRESS, MAIL_TO_ADDRESS, ALTCHA_HMAC_KEY, CLIENT_IP_HEADER, TRUSTED_PROXIES,
# RATE_LIMIT_MAX, RATE_LIMIT_WINDOW_SECONDS, CHALLENGE_LIMIT_MAX, MAIL_LIMIT_PER_HOUR.
# Meaning and defaults: docs/deploy.md.
