# Names only. This repo is public: never put values here.
#
# Contact form server (server/), runtime environment set in Plesk per domain
# (staging.bonis.de and www.bonis.de each have their own). Meaning and defaults: docs/deploy.md.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_SERVERNAME=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_TO_ADDRESS=
ALTCHA_HMAC_KEY=
CLIENT_IP_HEADER=
TRUSTED_PROXIES=
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_SECONDS=
CHALLENGE_LIMIT_MAX=
MAIL_LIMIT_PER_HOUR=

# release.sh only (local .env, gitignored): Plesk Git webhook URLs (the uuid is a secret)
PLESK_WEBHOOK_STAGING=
PLESK_WEBHOOK_LIVE=
