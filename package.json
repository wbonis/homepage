{
	"name": "macos-svelte",
	"version": "13.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:api": "node server/entry.mjs --dev --client dist",
		"build": "vite build",
		"serve": "vite preview",
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
		"check": "pnpm typecheck && pnpm test:server && pnpm test:tools && pnpm build && pnpm test:csp",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json && npm --prefix server run --silent typecheck",
		"test:server": "npm --prefix server test",
		"test:tools": "node --test \"tests/*.test.ts\"",
		"test:csp": "node tools/check-csp.mjs"
	},
	"devDependencies": {
		"@iconify-json/gg": "^1.2.1",
		"@iconify-json/ic": "^1.2.1",
		"@iconify-json/icon-park-outline": "^1.2.1",
		"@iconify-json/iconamoon": "^1.2.1",
		"@iconify-json/majesticons": "^1.2.1",
		"@iconify-json/mdi": "^1.2.1",
		"@iconify-json/pepicons": "^1.2.0",
		"@iconify-json/ph": "^1.2.1",
		"@iconify-json/uil": "^1.2.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "^25.3.1",
		"browserslist": "^4.24.2",
		"lightningcss": "^1.27.0",
		"parse5": "^8.0.1",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "5.34.8",
		"svelte-check": "^4.0.5",
		"typescript": "^5.6.3",
		"vite": "^8.3.0",
		"vite-imagetools": "^12.0.1",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-window": "^7.3.0"
	},
	"dependencies": {
		"@fontsource/inter": "^5.1.0",
		"@neodrag/core": "3.0.0-next.3",
		"@neodrag/svelte": "3.0.0-next.3",
		"date-fns": "^4.1.0",
		"popmotion": "^11.0.5",
		"unplugin-icons": "^0.19.3"
	},
	"packageManager": "pnpm@10.12.3"
}
